# Scraper settings. In the full stack these come from the root .env (see ../.env.example); this file is
# for running the scraper on its own from this directory.

# Firecrawl renders JavaScript-heavy pages (used by Shine). Self-hosted: see ../firecrawl and the root README.
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=

# Ollama (optional LLM extraction, `scraper run --extract`). OLLAMA_URL is still read as an alias.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=6144
EXTRACTION_MIN_CHARS=300

# Politeness
MAX_CONCURRENCY=2
REQUEST_DELAY_SECONDS=1.5

# Discovery defaults (comma separated); CLI flags override these
SEARCH_QUERIES=intern,new grad,entry level
LOCATIONS=India

# Output (JSONL cache + dead letters)
OUTPUT_DIR=data
MAX_MARKDOWN_CHARS=20000

# Greenhouse company board tokens (comma separated)
GREENHOUSE_COMPANIES=databricks,okta,gitlab,rubrik,netskope,elastic,twilio,coinbase,datadog,groww,airbnb,stripe,mixpanel,anthropic,zscaler,vercel,mongodb,figma,cloudflare

# Sending results to the backend (`scraper run --push`, `scraper serve`)
BACKEND_URL=http://localhost:8000
INGEST_TOKEN=            # must equal the backend's INGEST_TOKEN
INGEST_BATCH_SIZE=100
BACKEND_TIMEOUT_SECONDS=60

# `scraper serve`
SERVE_SOURCES=unstop,shine,internshala
SERVE_LIMIT=300
SCRAPE_INTERVAL_HOURS=12
RUN_ON_START=true
METRICS_PORT=9100
ALERTS_AFTER_RUN=true
