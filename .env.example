# Copy to .env and fill in the values marked REQUIRED:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# ----- Database (REQUIRED password). Use letters and digits only: it is placed inside a URL.
POSTGRES_USER=jobs
POSTGRES_PASSWORD=
POSTGRES_DB=jobs

# ----- Backend
# REQUIRED. Signs session cookies; anyone who knows it can forge a login. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# REQUIRED. Shared secret the scraper sends as X-Ingest-Token to POST /internal/jobs. Generate the same way.
INGEST_TOKEN=
# Optional. If both are set, this admin account is created/updated every time the backend starts
# (the admin can see the skill-gap and curriculum analytics). Password: at least 8 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Browser origins allowed to call the API with cookies (comma separated). Behind the bundled nginx
# the app and API share an origin, so the default is enough.
CORS_ORIGINS=http://localhost
# Set to true when the site is served over HTTPS so the session cookie is HTTPS-only.
SESSION_COOKIE_SECURE=false
# The address people use to reach the site; used for links in emails.
PUBLIC_URL=http://localhost
# Postings not seen by the scraper for this many days are marked inactive.
STALE_DAYS=14

# ----- Email alerts. The default sends to the bundled Mailpit (inspect mail at http://localhost:8025).
# For real delivery, point these at your SMTP server (and you may then remove the mailpit service).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=alerts@jobs.local
# Only matches at or above this skills-match percentage are emailed.
ALERT_MIN_SCORE=60
MAILPIT_UI_PORT=8025

# ----- Scraper
# Firecrawl runs OUTSIDE this compose file. host.docker.internal reaches services on your machine.
FIRECRAWL_API_URL=http://host.docker.internal:3002
FIRECRAWL_API_KEY=
# Which sources the scheduled scraper visits, how many jobs per source per run, and how often.
SERVE_SOURCES=unstop,shine,internshala
SERVE_LIMIT=300
SCRAPE_INTERVAL_HOURS=12
RUN_ON_START=true
REQUEST_DELAY_SECONDS=1.5
MAX_CONCURRENCY=2
GREENHOUSE_COMPANIES=databricks,okta,gitlab,rubrik,netskope,elastic,twilio,coinbase,datadog,groww,airbnb,stripe,mixpanel,anthropic,zscaler,vercel,mongodb,figma,cloudflare

# ----- Monitoring: Prometheus collects the app's numbers, Grafana draws them at http://localhost/grafana/
# First login for Grafana. admin / admin is fine on your own machine; use real values before exposing the site.
# (Only applied the first time Grafana starts with an empty data volume; change it later in Grafana's profile page.)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Prometheus's own page, published on this machine only (127.0.0.1), and how long it keeps history.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# ----- Networking / images
# Port the site is published on.
HTTP_PORT=80
# Only for docker-compose.prod.yml (prebuilt images from GHCR, see README). Leave unset for local builds.
#IMAGE_PREFIX=ghcr.io/haarish-ahmad/job-aggregator-platform
#IMAGE_TAG=latest
