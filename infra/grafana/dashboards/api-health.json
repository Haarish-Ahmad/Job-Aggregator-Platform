      "description": "Responses with a 5xx status. Empty means no errors."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Active postings by source",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
