      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "failed = not delivered (they are re-sent on the next run)."
    },
    {
      "id": 23,
